# GlowNest Beauty Studio - Environment Variables Template
# Copy this file to .env and fill in your actual values
# NEVER commit .env to Git

# ---- Django Core ----
# Generate a strong secret key for production:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-secure-secret-key-change-in-production

# Set to False in production
DEBUG=True

# Comma-separated list of allowed host domains
ALLOWED_HOSTS=localhost,127.0.0.1

# ---- Database ----
# PostgreSQL connection URL for production (Supabase, Render, etc.)
# Leave unset to use SQLite for local development
# DATABASE_URL=postgres://username:password@host:5432/dbname

# ---- CORS (Production) ----
# Comma-separated list of allowed origins for CORS (optional)
# CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# ---- Contact & Business ----
# Your WhatsApp Business number (with country code)
WHATSAPP_NUMBER=+911234567890

# ---- Render Deployment ----
# Automatically set by Render — used for ALLOWED_HOSTS and CORS
# RENDER_EXTERNAL_HOSTNAME=yourapp.onrender.com

# ---- Email Configuration (Optional — for contact form email notifications) ----
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=your-email@gmail.com
# EMAIL_HOST_PASSWORD=your-app-password
# DEFAULT_FROM_EMAIL=GlowNest Beauty Studio <hello@glownest.com>
